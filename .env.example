# ── Base de datos (PostgreSQL) ─────────────────────────────
DB_HOST=localhost
DB_USER=rutasmap
DB_PASSWORD=rutasmap
DB_PORT=5434
DB_NAME=analisisstrava
# Postgres local (Docker) no usa TLS. En producción con BD gestionada, omitir.
DB_SSL=false
# Si la BD gestionada usa una CA no confiada por Node (solo local):
# DB_SSL_REJECT_UNAUTHORIZED=false

# ── Auth ───────────────────────────────────────────────────
# Obligatorio en producción. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# OAuth de Strava (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# URL pública de la API (redirect_uri de OAuth) y del frontend
APP_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5180

# Admins (separados por coma)
ADMIN_STRAVA_ID=
ADMIN_EMAILS=

# ── Servidor de desarrollo ─────────────────────────────────
API_PORT=3002
# ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4173
